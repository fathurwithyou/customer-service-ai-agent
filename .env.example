# Copy to .env. Everything here has a working default except the Groq key.

# --- Model -----------------------------------------------------------------------------
# Without a key the agent falls back to Pydantic AI's keyless `test` model, so the service
# still boots and /health answers -- but /chat will not say anything useful.
TOKOKITA_GROQ_API_KEY=gsk_your_key_here
TOKOKITA_MODEL_NAME=openai/gpt-oss-20b
# Groq's free tier is 200k tokens/DAY per model. One turn costs ~2k, so heavy testing
# exhausts a model for the day; switching model id is the workaround.
# Leave empty for a non-reasoning model, which would reject the parameter.
TOKOKITA_REASONING_FORMAT=parsed

# --- Data ------------------------------------------------------------------------------
TOKOKITA_DATABASE_URL=postgresql+asyncpg://tokokita:tokokita@localhost:5433/tokokita

# --- Observability ---------------------------------------------------------------------
# Phoenix, over OTLP HTTP/protobuf. Leave empty to disable the Phoenix exporter entirely.
TOKOKITA_PHOENIX_ENDPOINT=http://localhost:6006
# Optional. Set it and traces also go to Logfire cloud; leave it out and they do not.
# TOKOKITA_LOGFIRE_TOKEN=pylf_v1_...
TOKOKITA_LOGFIRE_ENVIRONMENT=development
